# Network Configuration
BSC_TESTNET_RPC_URL=https://data-seed-prebsc-1-s1.binance.org:8545
BSC_MAINNET_RPC_URL=https://bsc-dataseed.binance.org/
NETWORK=testnet

# Private Keys (NEVER commit actual keys!)
# Hardhat 部署脚本优先使用 DEPLOY_PRIVATE_KEY，未设置时可用 PRIVATE_KEY
DEPLOY_PRIVATE_KEY=your_deploy_private_key_here
PRIVATE_KEY=your_private_key_here
BACKEND_PRIVATE_KEY=your_backend_private_key_here
MARKET_MAKER_PRIVATE_KEY=your_market_maker_private_key_here

# Contract Addresses (will be filled after deployment)
RWA_TOKEN_ADDRESS=
STAKING_CONTRACT_ADDRESS=
TREASURY_ADDRESS=
LIQUIDITY_FUND_ADDRESS=
PANCAKESWAP_PAIR_ADDRESS=

# BSCScan API Key (for contract verification)
BSCSCAN_API_KEY=your_bscscan_api_key_here

# Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_NAME=rwa_protocol
DB_USER=rwa_user
DB_PASSWORD=your_strong_password_here

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Price Oracle Configuration
PRICE_ORACLE_CACHE_TTL=300
PANCAKE_ROUTER_ADDRESS=0x10ED43C718714eb63d5aA57B78B54704E256024E
USDT_TOKEN_ADDRESS=0x55d398326f99059fF775485246999027B3197955

# Backend API Configuration
PORT=3000
API_HOST=0.0.0.0
CORS_ORIGIN=*

# Event Monitor Configuration
CONFIRMATION_BLOCKS=12
POLL_INTERVAL=5000

# Logging
LOG_LEVEL=info

# Reward Calculation
MAX_REWARD_PER_CALL=10000000000000000000000
DAILY_YIELD_RATE=0.008

# Monitoring and Alerts
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
ALERT_ENABLED=false

# Market Maker Bot Configuration
MARKET_MAKER_MIN_BUY_AMOUNT=10
MARKET_MAKER_MAX_BUY_AMOUNT=50
MARKET_MAKER_MIN_INTERVAL=1800
MARKET_MAKER_MAX_INTERVAL=7200
MARKET_MAKER_DAILY_LIMIT=500
