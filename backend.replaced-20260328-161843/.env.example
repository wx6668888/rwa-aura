# Backend Environment Variables

# RPC
RPC_URL=https://bsc-dataseed.binance.org/

# Wallets
BACKEND_PRIVATE_KEY=your_backend_wallet_private_key
TREASURY_PRIVATE_KEY=your_treasury_wallet_private_key

# Contracts
STAKING_CONTRACT=0x...
USDT_TOKEN=0x55d398326f99059fF775485246999027B3197955
RWA_TOKEN=0x...
TREASURY_ADDRESS=0x...

# Database
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password
DB_NAME=rwa_protocol

# 每日收益结算
# chain（默认）：从链上 StakeEvent/RWAStakeEvent 收集地址，用合约 view 在结算窗口起点区块算收益（不依赖 balance_snapshots）
# db：旧逻辑，仅扫描 balance_snapshots 表
DAILY_SETTLEMENT_DATA_SOURCE=chain
# 质押合约部署块（强烈建议配置，否则会从 latest-500000 扫日志，RPC 较慢）
# STAKING_DEPLOY_BLOCK=12345678
