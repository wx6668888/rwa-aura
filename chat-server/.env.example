PORT=3002
# 原生 Anthropic（密钥以 sk-ant- 开头），与 LLM_OPENAI_COMPAT_* 不是同一路
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-3-5-haiku-20241022
# 若 CLAUDE_API_KEY 为 sk-ant-*，也会作为 Anthropic 原生 Key 使用
# CLAUDE_API_KEY=
# 需与前端 dev 地址一致（若前端用 3050 端口，请改为 http://localhost:3050）
CORS_ORIGIN=http://localhost:3000
CHAT_DATA_FILE=./data/chat-data.json
CHAT_ADMIN_ADDRESSES=0xYourAdminWallet1,0xYourAdminWallet2

# OpenAI-compat gateway (optional, e.g. Codex proxy; Bearer = key)
# LLM_OPENAI_COMPAT_BASE_URL=https://code.newcli.com/codex/v1
# LLM_OPENAI_COMPAT_API_KEY=
# LLM_OPENAI_COMPAT_MODEL=gpt-5
# LLM_PROVIDER_ORDER=openaicompat,groq,siliconflow,openrouter,xfyun
# ADMIN_OPENAI_COMPAT_API_KEY=

# 移动端「官方客服」底部弹层 /api/chat/support/ask 专用 LLM Key（与群聊机器人池隔离）
# 不配则回退 ADMIN_* 或全局 Key。可用 SUPPORT_SHEET_GROQ_API_KEYS 逗号/换行多 Key。
SUPPORT_SHEET_GROQ_API_KEY=
# SUPPORT_SHEET_OPENROUTER_API_KEY=
# SUPPORT_SHEET_SILICONFLOW_API_KEY=
# SUPPORT_SHEET_MAX_TOKENS=720


# 红包配置
CHAT_RED_PACKET_EXPIRE_MS=86400000
CHAT_RED_PACKET_ASSET=USDT
CHAT_RED_PACKET_RPC_URL=https://bsc-dataseed.binance.org
CHAT_RED_PACKET_TOKEN_ADDRESS=
CHAT_RED_PACKET_TOKEN_DECIMALS=18
