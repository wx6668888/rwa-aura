{
  "apps": [
    {
      "name": "rwa-backend",
      "script": "npm",
      "args": "run server",
      "cwd": "/www/wwwroot/rwaprotocol.dpdns.org/backend",
      "instances": 1,
      "autorestart": true,
      "watch": false,
      "max_memory_restart": "500M",
      "env": {
        "NODE_ENV": "production"
      },
      "error_file": "/www/wwwroot/rwaprotocol.dpdns.org/logs/error.log",
      "out_file": "/www/wwwroot/rwaprotocol.dpdns.org/logs/out.log",
      "log_date_format": "YYYY-MM-DD HH:mm:ss",
      "merge_logs": true,
      "min_uptime": "10s",
      "max_restarts": 10,
      "restart_delay": 4000
    }
  ]
}
