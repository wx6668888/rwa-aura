# Backend Environment Variables

# RPC
RPC_URL=https://bsc-dataseed.binance.org/

# Wallets
BACKEND_PRIVATE_KEY=your_backend_wallet_private_key
TREASURY_PRIVATE_KEY=your_treasury_wallet_private_key

# Contracts
STAKING_CONTRACT=0x...
USDT_TOKEN=0x55d398326f99059fF775485246999027B3197955
RWA_TOKEN=0x...
TREASURY_ADDRESS=0x...

# Database
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password
DB_NAME=rwa_protocol

# 每日收益结算
# chain（默认）：从链上 StakeEvent 日志收集地址；收益=合约 view 在「结算日界起点」区块的仓位 × 日收益率（不读 balance_snapshots）
# db：仅从 stake_events 收集候选地址；收益计算与 chain 相同（均为链上）。勿再用 balance_snapshots 做日结。
DAILY_SETTLEMENT_DATA_SOURCE=chain
# 防重复发放：npx ts-node --transpile-only scripts/dedupe-yield-settlements.ts 后执行 database/migrations/20260329_yield_settlements_unique.sql
# 建议配置 REDIS_HOST/REDIS_PORT 启用日结分布式锁；PM2 cluster 多实例须单实例跑日结或必配 Redis
# 质押合约部署块（强烈建议配置，否则会从 latest-500000 扫日志，RPC 较慢）
# STAKING_DEPLOY_BLOCK=12345678
