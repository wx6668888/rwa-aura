{
  "name": "rwa-backend",
  "version": "1.0.0",
  "description": "Backend services for RWA Tokenization Protocol",
  "main": "dist/index.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/dev-server.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "jest",
    "lint": "eslint . --ext .ts",
    "migrate:up": "ts-node src/config/migrations/001_initial_schema.ts up",
    "migrate:down": "ts-node src/config/migrations/001_initial_schema.ts down",
    "db:stats": "ts-node src/scripts/db-stats.ts",
    "check-env": "ts-node --transpile-only src/scripts/check-env.ts"
  },
  "keywords": [
    "RWA",
    "Backend",
    "BSC"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/morgan": "^1.9.9",
    "@types/node": "^20.11.0",
    "@types/node-cron": "^3.0.11",
    "@typescript-eslint/eslint-plugin": "^6.19.0",
    "@typescript-eslint/parser": "^6.19.0",
    "eslint": "^8.56.0",
    "jest": "^29.7.0",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.3.3"
  },
  "dependencies": {
    "bignumber.js": "^9.1.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.1",
    "ethers": "^6.10.0",
    "express": "^4.18.2",
    "helmet": "^7.1.0",
    "morgan": "^1.10.0",
    "mysql2": "^3.9.0",
    "node-cron": "^3.0.3",
    "redis": "^4.6.12",
    "winston": "^3.11.0"
  }
}
