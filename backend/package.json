{
  "name": "meta-relayer",
  "version": "1.0.0",
  "scripts": {
    "start": "ts-node src/services/meta-relayer.ts",
    "server": "ts-node src/index.ts",
    "monitor": "ts-node src/services/event-monitor-full.ts",
    "settlement": "node -e \"console.error('Use: npx ts-node scripts/run-daily-settlement-once.ts'); process.exit(1)\"",
    "sync-stats": "ts-node src/scripts/sync-user-stats.ts",
    "verify-bsc-addresses": "ts-node --transpile-only src/scripts/verify-bsc-address-alignment.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typecheck:ci": "tsc -p tsconfig.ci.json --noEmit",
    "test:settlement-invariants": "ts-node --transpile-only scripts/test-daily-settlement-invariants.ts",
    "test": "npm run typecheck && npm run typecheck:ci && npm run test:settlement-invariants",
    "dedupe:yield-settlements": "ts-node --transpile-only scripts/dedupe-yield-settlements.ts",
    "migrate:yield-settlements-unique": "ts-node --transpile-only scripts/apply-yield-settlements-unique-migration.ts",
    "remediation:yield-data": "ts-node --transpile-only scripts/run-full-yield-data-remediation.ts",
    "report:phantom-prededupe": "ts-node --transpile-only scripts/report-phantom-principal-from-prededupe-snapshots.ts",
    "export:stake-events": "ts-node --transpile-only scripts/export-stake-events-full.ts",
    "verify:yield-post-fix": "ts-node --transpile-only scripts/verify-yield-data-post-fix.ts",
    "reconcile:yield-vs-stake-ledger": "ts-node --transpile-only scripts/reconcile-yield-settlements-vs-stake-ledger.ts",
    "batch:reconcile-yield-ledger": "ts-node --transpile-only scripts/batch-reconcile-yield-ledger-persist.ts"
  },
  "dependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "better-sqlite3": "^12.6.2",
    "bignumber.js": "^10.0.2",
    "cors": "^2.8.5",
    "dotenv": "^17.3.1",
    "ethers": "^6.9.0",
    "express": "^4.18.2",
    "helmet": "^8.1.0",
    "ioredis": "^5.10.0",
    "morgan": "^1.10.1",
    "mysql2": "^3.20.0",
    "node-cron": "^4.2.1",
    "redis": "^5.11.0",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/helmet": "^0.0.48",
    "@types/morgan": "^1.9.10",
    "@types/node-cron": "^3.0.11",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  }
}
