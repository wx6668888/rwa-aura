const translations: Record<Locale, TranslationMap> = {
  zh,
  en,
  ko,
  es,
  ar,
  hi,
  fr,
  pt,
  ru,
  ja,
}

export function getTranslation(locale: Locale, key: string, params?: Record<string, string | number>): string {
  const keys = key.split('.')
  
  // Try current locale first
  let value: string | TranslationMap | undefined = translations[locale]
  
  // If locale not found or value is undefined, try fallback chain: locale -> en -> zh
  const fallbackChain: Locale[] = [locale]
  if (locale !== 'en') fallbackChain.push('en')
  if (locale !== 'zh' && locale !== 'en') fallbackChain.push('zh')
  
  for (const fallbackLocale of fallbackChain) {
    let currentValue: string | TranslationMap | undefined = translations[fallbackLocale]
    
    // Traverse the key path
  for (const segment of keys) {
      if (typeof currentValue === 'object' && currentValue !== null) {
        currentValue = currentValue[segment]
    } else {
        currentValue = undefined
        break
      }
    }
    
    // If we found a string value, replace placeholders and return it
    if (typeof currentValue === 'string') {
      let result = currentValue
      if (params) {
        // Replace ${key} placeholders
        for (const [paramKey, paramValue] of Object.entries(params)) {
          result = result.replace(new RegExp(`\\$\\{${paramKey}\\}`, 'g'), String(paramValue))
          // Also replace {key} placeholders
          result = result.replace(new RegExp(`\\{${paramKey}\\}`, 'g'), String(paramValue))
        }
      }
      return result
    }
  }
  
  // If nothing found, return the key
  return key
}

export function useTranslation(locale: Locale = 'zh') {
  return {
    t: (key: string, params?: Record<string, string | number>) => getTranslation(locale, key, params),
    locale,
  }
}

export default translations


